# Runs figiran-backup.service every night (see that file).
#   sudo systemctl enable --now figiran-backup.timer
#   systemctl list-timers figiran-backup.timer

[Unit]
Description=Nightly backup of figiran-server's data directory

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
