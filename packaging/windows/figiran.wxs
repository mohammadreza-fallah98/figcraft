<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="FigIran" Manufacturer="Learning Machines LLC" Version="$(var.Version)" UpgradeCode="7F8B9827-D065-41B7-A514-2A454B21F484" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="FigIran interface design and prototyping tool" Manufacturer="Learning Machines LLC" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of FigIran is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="FigiranIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="FigiranIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getfigiran.com/apps/figiran" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getfigiran.com/apps/figiran" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/figiran" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="FigIran">
        <Directory Id="INSTALLFOLDER" Name="FigIran" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by FigiranApp). -->

    <Feature Id="Main" Title="FigIran" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="FigiranFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchFigiran" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through figiran.en-us.wxl. -->
    <Property Id="FigiranVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="FigIran $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FigIran" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#FigiranExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchFigiran" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="FigiranFiles" Directory="INSTALLFOLDER">
      <Component Id="FigiranApp" Guid="238228C3-4C1D-4B33-8C5D-C31B65BC2DA4">
        <File Id="FigiranNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="FigiranExe" Source="$(var.BinDir)\figiran.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FigIran" Description="FigIran interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="FigiranIcon.exe" IconIndex="0" />
        </File>

        <!-- .figiran: FigIran's own format; FigIran is its default app. -->
        <ProgId Id="Figiran.Document" Description="FigIran Document" Icon="FigiranExe" IconIndex="0">
          <Extension Id="figiran" ContentType="application/x-figiran">
            <Verb Id="open" Command="Open" TargetFile="FigiranExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Figiran.Image" Description="Image" Icon="FigiranExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Figiran.Image\shell\open\command" Value="&quot;[#FigiranExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.svg\OpenWithProgids" Name="Figiran.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="Figiran.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Figiran.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Figiran.Image" Value="" Type="string" />
        <!-- Sketch files (opened as a copy; FigIran doesn't save .sketch): "Open with" only too. -->
        <ProgId Id="Figiran.Sketch" Description="Sketch Document" Icon="FigiranExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Figiran.Sketch\shell\open\command" Value="&quot;[#FigiranExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sketch\OpenWithProgids" Name="Figiran.Sketch" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "figiran"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe" Name="FriendlyAppName" Value="FigIran" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\shell\open\command" Value="&quot;[#FigiranExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".figiran" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figiran.exe\SupportedTypes" Name=".sketch" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\figiran.exe" Value="[#FigiranExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\FigIran" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="FigiranCli">
        <File Id="FigiranCliExe" Source="$(var.BinDir)\figiran-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
